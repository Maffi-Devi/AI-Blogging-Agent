# Names only. Real values go in C:\Users\asus\.config\claude-seo\blogger.env (local)
# and in GitHub → Settings → Secrets and variables → Actions (cloud). Never in this repo.

# --- Research and images (all free plans) ---
SERPAPI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
PEXELS_API_KEY=

# --- Blogger API (Google Cloud → OAuth client, type "Desktop app") ---
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
# Filled in by: node scripts/blogger-auth.mjs
BLOGGER_REFRESH_TOKEN=
BLOGGER_BLOG_ID=

# --- The writer (from: claude setup-token) ---
CLAUDE_CODE_OAUTH_TOKEN=

# --- Cover image hosting: a PUBLIC repo for images (README, "Cover image hosting") ---
# ASSETS_DEPLOY_KEY (GitHub Secret only) = private half of a write deploy key of that repo
ASSETS_REPO=AN-Web-Services/blog-images
